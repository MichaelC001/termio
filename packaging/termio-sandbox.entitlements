<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the termio-sandbox helper. The Virtualization entitlement is
     what lets it create the lightweight Linux VM (and its vmnet network) at the OS
     level. Only the helper carries this; the main app does not need it. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
