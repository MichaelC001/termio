{
  "id": "opencode",
  "order": 30,
  "name": "OpenCode",
  "wire": "opencode",
  "command": "opencode",
  "permissionBypassFlag": "--auto",
  "resume": {
    "resume": "--session {id}",
    "discover": {
      "root": "~/.local/share/opencode/storage/session",
      "format": "json",
      "id": "id",
      "cwd": "directory"
    }
  },
  "icon": { "asset": "opencode-favicon" },
  "install": "https://opencode.ai",
  "skills": { "dir": "~/.config/opencode/skills" },
  "hooks": {
    "type": "plugin",
    "dir": "~/.config/opencode/plugins",
    "dialect": "opencode",
    "conversation": "sessionID",
    "events": [
      { "on": "session.status", "state": "working", "matcher": "busy" },
      { "on": "session.status", "state": "done", "matcher": "idle" },
      { "on": "permission.asked", "state": "attention" }
    ]
  }
}
