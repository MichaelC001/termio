# Supabase Postgres connection string.
# Use the *pooled* connection (Transaction mode, port 6543) for the running app,
# and the *direct* connection (port 5432) for drizzle-kit migrations if the
# pooler rejects DDL. Copy from Supabase: Project Settings -> Database -> Connection string.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Secret used by better-auth to sign sessions/tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-secret"

# Public base URL of THIS server (where /api/auth lives). Used for OAuth callbacks.
BETTER_AUTH_URL="http://localhost:8787"

# Origin of the landing page / web client allowed to call this API (CORS + cookies).
WEB_ORIGIN="http://localhost:3000"

# Port this HTTP server listens on.
PORT="8787"

# GitHub OAuth app credentials (Settings -> Developer settings -> OAuth Apps).
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth client credentials (Google Cloud Console -> Credentials).
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe secret API key (sk_test_... in test mode, sk_live_... in production).
# Required by `pnpm stripe:setup` (provisions Products/Prices) and by checkout.
# When blank, /api/checkout/session returns the Checkout params as a stub instead
# of charging. See docs/STRIPE.md for the full go-live runbook.
STRIPE_SECRET_KEY=""

# Stripe webhook signing secret (whsec_...), shown when you create the webhook
# endpoint at <deployed>/api/checkout/webhook. Subscribe to EXACTLY the events the
# code handles: checkout.session.completed, charge.refunded, checkout.session.expired.
# With the Stripe CLI, `stripe listen` prints a whsec_ to use locally.
STRIPE_WEBHOOK_SECRET=""

# NOTE: Stripe Tax must be enabled in the Stripe Dashboard (Settings → Tax). The
# checkout session sets automatic_tax.enabled = true; as Merchant of Record you are
# responsible for registering and remitting tax in each jurisdiction — Stripe Tax
# calculates and collects, it does not remit. See docs/STRIPE.md.
